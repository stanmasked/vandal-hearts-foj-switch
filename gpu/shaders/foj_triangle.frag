#version 450 core
/* Clean-room FIRST GPU TRIANGLE fragment shader: no textures or PS3 assets.
 * UVs are generated by the invented 24-byte FojGpuVertex test triangle.
 */
layout(location=0) in vec2 vUV;
layout(location=0) out vec4 oColor;

void main() {
    oColor = vec4(vUV.x, vUV.y, 0.30, 1.0);
}
